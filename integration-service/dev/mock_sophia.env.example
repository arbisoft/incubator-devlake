# Settings for the mock Sophia (dev/mock_sophia.py) only; the Integration Service never reads this file.
# Copy to dev/mock_sophia.env (gitignored), which the mock reads at start. See "Mock Sophia" in README.md.

# Sophia as the client: the Client ID it uses at the Integration Service, and a secret created for that client in the admin portal.
SOPHIA_CLIENT_ID=sophia-local
SOPHIA_CLIENT_SECRET=

# Sophia as the callback receiver: what the Integration Service must use at mock Sophia's token endpoint. Enter the same two values
# as the outbound client ID and secret in the client's outbound config in the admin portal.
SOPHIA_OUTBOUND_CLIENT_ID=devlake-local
SOPHIA_OUTBOUND_CLIENT_SECRET=

# Optional (these are the defaults).
# INTEGRATION_SERVICE_URL=http://localhost:5099
# MOCK_SOPHIA_PORT=5097
# For --emails-from-devlake: DevLake's database. The password is read from DB_URL in the repository root's .env unless given here.
# DEVLAKE_DB_CONTAINER=devlake-mysql-1
# DEVLAKE_DB_NAME=lake
# DEVLAKE_DB_USER=merico
# DEVLAKE_DB_PASSWORD=
