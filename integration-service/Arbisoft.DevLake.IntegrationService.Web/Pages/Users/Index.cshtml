@page
@using Arbisoft.DevLake.IntegrationService.DataAccess.Models
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}
<h1>Users</h1>
<p class="muted">Everyone who has signed in to the portal. A new Arbisoft account has no access until you grant it. <strong>Editor</strong> sees all data and makes changes; <strong>Admin</strong> can also manage users here.</p>
<div class="table-wrap">
<table>
  <thead><tr><th>User</th><th>Sign-in</th><th>Last signed in</th><th>Access</th><th></th></tr></thead>
  <tbody>
  @foreach (var user in Model.Users)
  {
      var self = user.Id == Model.SignedInUserId;
      <tr>
        <td>
          <strong>@(user.DisplayName ?? user.SignInName)</strong>
          @if (user.DisplayName is not null) { <div class="mono muted">@user.SignInName</div> }
          @if (!user.IsActive) { <div><span class="badge danger">Disabled</span></div> }
        </td>
        <td>@(user.IsLocal ? "Local password" : "Single sign-on")</td>
        <td>@AdminPageModel.Utc(user.LastSignInOn)</td>
        <td>
          @if (self)
          {
              <span class="badge @(user.Role == PortalRole.None ? "" : "ok")">@user.Role</span> <span class="muted">(you)</span>
          }
          else
          {
              <form method="post" class="inline-form">
                <input type="hidden" name="id" value="@user.Id">
                <select name="role" aria-label="Access for @user.SignInName">
                  <option value="@PortalRole.None" selected="@(user.Role == PortalRole.None)">No access</option>
                  <option value="@PortalRole.Editor" selected="@(user.Role == PortalRole.Editor)">Editor</option>
                  <option value="@PortalRole.Admin" selected="@(user.Role == PortalRole.Admin)">Admin</option>
                </select>
                <label class="check"><input type="checkbox" name="isActive" value="true" @(user.IsActive ? "checked" : "")> Active</label>
                <input type="hidden" name="isActive" value="false">
                <button type="submit" class="secondary">Save</button>
              </form>
          }
        </td>
        <td class="muted">@(user.ModifiedBy is null ? "" : $"Changed by {user.ModifiedBy}")</td>
      </tr>
  }
  @if (Model.Users.Count == 0)
  {
      <tr><td colspan="5" class="muted">No users yet.</td></tr>
  }
  </tbody>
</table>
</div>
