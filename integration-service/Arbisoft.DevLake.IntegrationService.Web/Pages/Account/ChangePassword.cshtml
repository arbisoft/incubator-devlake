@page
@using Arbisoft.DevLake.IntegrationService.Business.Services.Admin
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<h1>Change password</h1>
@if (Model.IsRequired)
{
    <p class="notice" role="status">You are signed in with the default password. Choose a new one before using the portal.</p>
}
<form method="post" class="stack panel">
  <label>Current password <input type="password" asp-for="CurrentPassword" autocomplete="current-password" required></label>
  <label>New password <input type="password" asp-for="NewPassword" autocomplete="new-password" minlength="@PortalUserService.MinPasswordLength" maxlength="@PortalUserService.MaxPasswordLength" required></label>
  <p class="muted">At least @PortalUserService.MinPasswordLength characters, and not the username.</p>
  <label>New password again <input type="password" asp-for="ConfirmPassword" autocomplete="new-password" required></label>
  <div class="actions"><button type="submit">Change password</button>@if (!Model.IsRequired) { <a href="/">Cancel</a> }</div>
</form>
