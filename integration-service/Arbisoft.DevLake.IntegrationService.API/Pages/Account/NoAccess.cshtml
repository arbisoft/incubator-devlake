@page
@model Arbisoft.DevLake.IntegrationService.API.Pages.Account.NoAccessModel
@{
    ViewData["Title"] = "No access yet";
}
<h1>No access yet</h1>
<div class="panel stack">
  <p class="notice" role="status">Ask the administrator to provide the access to the portal.</p>
  <p class="muted">You are signed in as <strong>@User.Identity?.Name</strong>. Once an administrator grants you access, reload this page.</p>
  <form method="post" asp-page="/Account/Logout"><button type="submit" class="secondary">Sign out</button></form>
</div>
