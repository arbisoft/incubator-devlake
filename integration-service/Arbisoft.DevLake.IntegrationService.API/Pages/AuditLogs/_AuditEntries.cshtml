@model AuditEntriesView
<div class="table-wrap">
<table class="audit">
  <thead><tr><th>Action At (UTC)</th><th>Action By</th><th>Action</th>@if (Model.ShowObject) { <th>Object</th> }<th>Changes</th><th>Note</th></tr></thead>
  <tbody>
  @foreach (var entry in Model.Entries)
  {
      var kind = AuditPages.KindOf(entry.EntityType);
      <tr>
        <td class="nowrap">@AdminPageModel.UtcSeconds(entry.OccurredOn)</td>
        <td>
          @AuditPages.ActorName(entry)
          @if (entry.IpAddress is not null) { <div class="mono muted">@entry.IpAddress</div> }
        </td>
        <td>@AuditPages.ActionName(entry.Action)</td>
        @if (Model.ShowObject)
        {
            <td>
              <span class="muted">@(kind?.Name ?? entry.EntityType)</span>
              <div><a asp-page="/AuditLogs/History" asp-route-type="@entry.EntityType" asp-route-id="@entry.EntityId" class="@(entry.EntityLabel is null ? "mono" : null)">@(entry.EntityLabel ?? entry.EntityId)</a></div>
            </td>
        }
        <td>
          @if (entry.Changes.Count > 0)
          {
              <ul class="changes">
              @foreach (var change in entry.Changes)
              {
                  <li>
                    <span class="field">@change.Field</span>
                    @if (change.Hidden)
                    {
                        <span class="muted">changed (hidden)</span>
                    }
                    else
                    {
                        @if (change.Old is not null) { <del>@change.Old</del> }
                        @if (change.Old is not null && change.New is not null) { <span class="arrow" aria-label="to">→</span> }
                        @if (change.New is not null) { <ins>@change.New</ins> }
                    }
                  </li>
              }
              </ul>
          }
        </td>
        <td>@entry.Reason</td>
      </tr>
  }
  @if (Model.Entries.Count == 0)
  {
      <tr><td colspan="@(Model.ShowObject ? 6 : 5)" class="muted">Nothing recorded.</td></tr>
  }
  </tbody>
</table>
</div>
