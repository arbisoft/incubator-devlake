@page
@model Arbisoft.DevLake.IntegrationService.API.Pages.AuditLogs.IndexModel
@using Arbisoft.DevLake.IntegrationService.Business.Services.Admin
@{
    ViewData["Title"] = "Audit log";
}
<h1>Audit log</h1>
<p class="muted">Every change made in the portal, every sign-in and token request, and every status change the service makes to a request. Entries are never changed or removed.</p>
<form method="get" class="panel filters">
  <label>Who
    <select name="Who">
      @foreach (var kind in AuditLogService.ActorKinds)
      {
          <option value="@kind" selected="@(kind == Model.SelectedWho)">@AuditPages.ActorKindName(kind)</option>
      }
      <option value="@IndexModel.Everyone" selected="@(Model.SelectedWho == IndexModel.Everyone)">Everyone</option>
    </select>
  </label>
  <label>Object
    <select name="EntityType">
      <option value="">Any object</option>
      @foreach (var type in AuditLogService.EntityTypes)
      {
          <option value="@type" selected="@(type == Model.EntityType)">@AuditPages.KindOf(type)!.Name</option>
      }
    </select>
  </label>
  <label>Action
    <select name="Action">
      <option value="">Any action</option>
      @foreach (var action in AuditLogService.Actions)
      {
          <option value="@action" selected="@(action == Model.Action)">@AuditPages.ActionName(action)</option>
      }
    </select>
  </label>
  <label>From (UTC date) <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")"></label>
  <label>To (UTC date, included) <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")"></label>
  <div class="actions"><button type="submit">Filter</button><a asp-page="Index">Clear</a></div>
</form>
<partial name="_AuditEntries" model="new AuditEntriesView(Model.Result.Items, ShowObject: true)" />
<div class="actions pager">
  <span class="muted">@Model.Result.TotalCount entries · page @Model.Result.Page of @Model.Result.TotalPages</span>
  @if (Model.Result.HasPrevious) { <a asp-page="Index" asp-all-route-data="Model.RouteFor(Model.Result.Page - 1)">Previous</a> }
  @if (Model.Result.HasNext) { <a asp-page="Index" asp-all-route-data="Model.RouteFor(Model.Result.Page + 1)">Next</a> }
</div>
