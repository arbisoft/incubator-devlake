@model Arbisoft.DevLake.IntegrationService.API.Pages.AuditLogs.HistoryModel
@* The history dialog's content. data-history-name gives history-modal.js the object's name from the trail, for a dialog opened without one. *@
<div data-history-kind="@Model.Kind.Name" data-history-name="@(Model.HasName ? Model.Label : null)">
  <partial name="_AuditEntries" model="new AuditEntriesView(Model.Result.Items, ShowObject: false)" />
  <div class="actions pager">
    <span class="muted">@Model.Result.TotalCount entries · page @Model.Result.Page of @Model.Result.TotalPages</span>
    @if (Model.Result.HasPrevious) { <a data-history-page-link asp-page="/AuditLogs/History" asp-route-type="@Model.Type" asp-route-id="@Model.EntityId" asp-route-PageNumber="@(Model.Result.Page - 1)">Previous</a> }
    @if (Model.Result.HasNext) { <a data-history-page-link asp-page="/AuditLogs/History" asp-route-type="@Model.Type" asp-route-id="@Model.EntityId" asp-route-PageNumber="@(Model.Result.Page + 1)">Next</a> }
  </div>
</div>
