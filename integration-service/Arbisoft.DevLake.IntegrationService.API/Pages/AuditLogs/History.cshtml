@page
@model Arbisoft.DevLake.IntegrationService.API.Pages.AuditLogs.HistoryModel
@{
    ViewData["Title"] = "History of " + Model.Label;
    ViewData[Breadcrumb.ParentsKey] = new[] { new Breadcrumb(Model.Kind.ListTitle, Url.Page(Model.Kind.ListPage)) };
    ViewData[Breadcrumb.CurrentKey] = "History of " + Model.Label;
}
<h1>History <span class="muted">· @Model.Kind.Name</span> @Model.Label</h1>
<p class="muted">Everything recorded about this @Model.Kind.Name.ToLowerInvariant(), by everyone, newest first. <a asp-page="Index" asp-route-Who="@IndexModel.Everyone" asp-route-EntityType="@Model.Type">All @Model.Kind.ListTitle.ToLowerInvariant() in the audit log</a></p>
<partial name="_AuditEntries" model="new AuditEntriesView(Model.Result.Items, ShowObject: false)" />
<div class="actions pager">
  <span class="muted">@Model.Result.TotalCount entries · page @Model.Result.Page of @Model.Result.TotalPages</span>
  @if (Model.Result.HasPrevious) { <a asp-page="History" asp-route-type="@Model.Type" asp-route-id="@Model.EntityId" asp-route-PageNumber="@(Model.Result.Page - 1)">Previous</a> }
  @if (Model.Result.HasNext) { <a asp-page="History" asp-route-type="@Model.Type" asp-route-id="@Model.EntityId" asp-route-PageNumber="@(Model.Result.Page + 1)">Next</a> }
</div>
