<!doctype html>
<html lang="en">
@{
    // The full portal is for editors and administrators. Anyone else signed in (no access yet, or a password to change) sees the plain card.
    var signedIn = User.Identity?.IsAuthenticated == true
        && Arbisoft.DevLake.IntegrationService.API.Portal.PortalAuthentication.HasAccess(User)
        && !User.HasClaim(Arbisoft.DevLake.IntegrationService.API.Portal.PortalAuthentication.MustChangePasswordClaim, "true");
    var isAdmin = User.IsInRole(Arbisoft.DevLake.IntegrationService.DataAccess.Models.PortalRole.Admin);
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    // The section a page belongs to is the first folder of its path (/Clients/Details is in Clients); the home page is /Index.
    string? Current(string section) =>
        (section == "Index" ? currentPage == "/Index" : currentPage.StartsWith("/" + section + "/", StringComparison.Ordinal)) ? "page" : null;
    var adminName = User.Identity?.Name ?? string.Empty;
}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>@ViewData["Title"] · DevLake Integration Service Admin</title>
  <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="~/favicon.ico" sizes="48x48">
  <link rel="apple-touch-icon" href="~/apple-touch-icon.png">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
@if (signedIn)
{
  <div class="shell">
    <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Show the menu">
    <header class="topbar">
      <a class="brand" asp-page="/Index"><span class="brand-mark"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h5l2-5 2 10 2-5h5"/></svg></span><span class="brand-text"><strong>Integration Service</strong><span>Admin portal</span></span></a>
      <label for="menu-toggle" class="menu-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg> Menu</label>
    </header>
    <aside class="sidebar">
      <a class="brand" asp-page="/Index"><span class="brand-mark"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h5l2-5 2 10 2-5h5"/></svg></span><span class="brand-text"><strong>Integration Service</strong><span>Admin portal</span></span></a>
      <nav class="nav" aria-label="Sections">
        <div class="nav-group">
          <a asp-page="/Index" aria-current="@Current("Index")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Overview</a>
        </div>
        <div class="nav-group">
          <div class="nav-label">Access</div>
          <a asp-page="/Clients/Index" aria-current="@Current("Clients")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h6"/></svg>Clients</a>
          <a asp-page="/Scopes/Index" aria-current="@Current("Scopes")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.4 8 9 4.6-.6 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>Scopes</a>
          <a asp-page="/SigningKeys/Index" aria-current="@Current("SigningKeys")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9M17 6l3 3M14 9l2 2"/></svg>Signing keys</a>
          <a asp-page="/AccessTokens/Index" aria-current="@Current("AccessTokens")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2M3 12h18"/></svg>Access tokens</a>
        </div>
        <div class="nav-group">
          <div class="nav-label">Delivery</div>
          <a asp-page="/ClientConfigs/Index" aria-current="@Current("ClientConfigs")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>Outbound configs</a>
          <a asp-page="/EmailMappings/Index" aria-current="@Current("EmailMappings")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Email mappings</a>
          <a asp-page="/UpstreamTokens/Index" aria-current="@Current("UpstreamTokens")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5"/><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>Upstream tokens</a>
        </div>
        <div class="nav-group">
          <div class="nav-label">Monitoring</div>
          <a asp-page="/RequestLogs/Index" aria-current="@Current("RequestLogs")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>Request logs</a>
          <a asp-page="/AuditLogs/Index" aria-current="@Current("AuditLogs")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg>Audit log</a>
        </div>
        @if (isAdmin)
        {
            <div class="nav-group">
              <div class="nav-label">Administration</div>
              <a asp-page="/Users/Index" aria-current="@Current("Users")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.7c1.6.8 2.7 2.6 3 5.3"/></svg>Users</a>
            </div>
        }
      </nav>
      <div class="account">
        <span class="avatar" aria-hidden="true">@(adminName.Length > 0 ? adminName[..1] : "?")</span>
        <span class="account-name" title="Signed in as @adminName">@adminName</span>
        <a class="account-link" href="/Account/ChangePassword" title="Change password" aria-label="Change password"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></a>
        <form method="post" asp-page="/Account/Logout"><button class="link" type="submit">Sign out</button></form>
      </div>
    </aside>
    <div class="content">
      <main>
        @if (currentPage != "/Index")
        {
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              <ol>
                <li><a asp-page="/Index">Overview</a></li>
                @foreach (var crumb in ViewData[Breadcrumb.ParentsKey] as IEnumerable<Breadcrumb> ?? [])
                {
                    <li><a href="@crumb.Url">@crumb.Label</a></li>
                }
                <li aria-current="page">@(ViewData[Breadcrumb.CurrentKey] ?? ViewData["Title"])</li>
              </ol>
            </nav>
        }
        @if (TempData.Peek("Message") is string message)
        {
            <div class="message" role="status">@message</div>
        }
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        @RenderBody()
      </main>
    </div>
  </div>
}
else
{
  <div class="auth">
    <div class="auth-card">
      <div class="brand"><span class="brand-mark"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h5l2-5 2 10 2-5h5"/></svg></span><span class="brand-text"><strong>Integration Service</strong><span>Admin portal</span></span></div>
      @if (TempData.Peek("Message") is string message)
      {
          <div class="message" role="status">@message</div>
      }
      <div asp-validation-summary="ModelOnly" class="errors"></div>
      @RenderBody()
    </div>
  </div>
}
@if (signedIn)
{
    <dialog id="history-dialog" class="modal" aria-labelledby="history-dialog-title">
      <div class="modal-head">
        <h2 id="history-dialog-title">History</h2>
        <button type="button" class="link" id="history-dialog-close" aria-label="Close">Close</button>
      </div>
      <div class="modal-body" id="history-dialog-body" aria-live="polite"></div>
    </dialog>
    <script src="~/js/history-modal.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
