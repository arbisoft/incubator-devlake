@page
@using Arbisoft.DevLake.IntegrationService.Business.Services.Admin
@model Arbisoft.DevLake.IntegrationService.API.Pages.UpstreamTokens.IndexModel
@{
    ViewData["Title"] = "Upstream tokens";
}
<h1>Upstream tokens</h1>
<p class="muted">The API tokens this service uses to call DevLake and Workstream. They are stored encrypted in the database and are never shown again: type a new one to replace the stored one. The API picks up a saved token within a minute, without a restart.</p>
@foreach (var row in Model.Tokens)
{
    <h2>@row.Name</h2>
    <div class="panel">
      @if (row.IsSet)
      {
          <p>A token is stored, saved @AdminPageModel.Utc(row.SavedOn)@(row.SavedBy is null ? "" : " by " + row.SavedBy).</p>
      }
      else
      {
          <p>No token is stored yet. Until one is, calls to @row.Name fail.</p>
      }
      <form method="post" asp-page-handler="Save" class="stack">
        <input type="hidden" name="system" value="@row.System">
        <label>@(row.IsSet ? "New token" : "Token") <input type="password" name="token" maxlength="@UpstreamTokenService.MaxTokenLength" autocomplete="new-password" required></label>
        <div class="actions"><button type="submit">Save @row.Name token</button></div>
      </form>
      @if (row.IsSet)
      {
          <form method="post" asp-page-handler="Check">
            <input type="hidden" name="system" value="@row.System">
            <div class="actions"><button type="submit">Check @row.Name token</button><span class="muted">Asks @row.Name whether it accepts the stored token.</span></div>
          </form>
      }
    </div>
}
