# Copy to .env for docker compose. Local development values only.
INTEGRATION_DB_ROOT_PASSWORD=change-me-root
INTEGRATION_DB_PASSWORD=change-me
RABBITMQ_USER=integration
RABBITMQ_PASSWORD=change-me

# Used by the service container (docker compose up -d api).
# The master key that encrypts stored secrets: 32 bytes of base64 (openssl rand -base64 32). Keep it; losing it makes stored secrets unreadable.
SECURITY_ENCRYPTION_KEY=
# Admin portal users are kept in the database. The first, admin with password admin, is created when there is none, and must change the
# password at the first sign-in. Others sign in with their Arbisoft account once single sign-on is set up:
# SSO_ENABLED=true
# SSO_DISPLAY_NAME=Arbisoft
# Google Workspace: https://accounts.google.com   Microsoft Entra ID: https://login.microsoftonline.com/<tenant id>/v2.0
# SSO_AUTHORITY=https://accounts.google.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# Optional. The database the service uses (default integration_service).
# INTEGRATION_DB_NAME=integration_service
# Optional. DevLake's API (default http://host.docker.internal:8080/rest/) and Workstream's (unset by default, so only /fetch/projects fails).
# DEVLAKE_BASE_URL=http://host.docker.internal:8080/rest/
# WORKSTREAM_BASE_URL=
