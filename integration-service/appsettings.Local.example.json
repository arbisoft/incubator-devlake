{
  // Copy to Arbisoft.DevLake.IntegrationService.API/appsettings.Local.json (next to the published appsettings.json) on the machine that runs the
  // service, and fill it in. Only the settings that differ from appsettings.json need to be here. Never commit the filled-in file.
  "Database": {
    "ConnectionString": "Server=<mysql host>;Port=3306;Database=integration_service;User=integration;Password=<password>"
  },
  "RabbitMq": {
    "HostName": "<rabbitmq host>",
    "UserName": "<user>",
    "Password": "<password>"
  },
  "Security": {
    "EncryptionKey": "<openssl rand -base64 32>"
  },
  "DevLake": {
    "BaseUrl": "http://<devlake host>:8080/rest/"
  },
  "Workstream": {
    "BaseUrl": "<workstream url>"
  },
  "Sso": {
    "Enabled": false,
    "DisplayName": "Arbisoft",
    "Authority": "https://accounts.google.com",
    "ClientId": "",
    "ClientSecret": ""
  },
  "DataProtection": {
    "KeysPath": "/var/lib/integration-service/keys"
  }
}
