# Backend-only values for database OIDC administration. Copy to
# auth-secrets.env for local development; never commit that file.
# Generate a base64-encoded 32-byte AES key, for example:
# openssl rand -base64 32
AUTH_OIDC_CREDENTIAL_KEY_ID=local-v1
AUTH_OIDC_CREDENTIAL_KEY=
AUTH_OIDC_CREDENTIAL_PREVIOUS_KEY_ID=
AUTH_OIDC_CREDENTIAL_PREVIOUS_KEY=

# Create a least-privilege Grafana service-account token that can update the
# Generic OAuth SSO settings. Do not expose it to Config UI or a browser.
GRAFANA_SSO_SERVICE_TOKEN=
