{
  "titlePath": [
    "Local Password Authentication - Phases 1-4 Full E2E Suite",
    "8. Account Disablement: Disabling user revokes active sessions and prevents authentication"
  ],
  "writes": [
    {
      "method": "POST",
      "path": "/api/access/local-users",
      "body": {
        "displayName": "Disable Test e2e_*",
        "loginName": "e2e_*",
        "role": "member"
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/local/change-password",
      "body": {
        "password": "<masked>"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/access/users/:id",
      "body": {
        "role": "member",
        "status": "disabled"
      }
    }
  ]
}
