{
  "titlePath": [
    "AWS connection through the UI",
    "rename the assume-role connection and keep the External ID and the broker secret"
  ],
  "writes": [
    {
      "method": "PATCH",
      "path": "/api/plugins/aws/connections/:id",
      "body": {
        "accessKeyId": "AK****************01",
        "authType": "ASSUME_ROLE",
        "name": "e2e-*-renamed",
        "rateLimitPerHour": 10000,
        "regions": ["us-east-2"],
        "roleArn": "arn:aws:iam::123456789012:role/e2e-devlake",
        "secretAccessKey": "",
        "sessionToken": "",
        "useCostExplorer": false
      }
    }
  ]
}
