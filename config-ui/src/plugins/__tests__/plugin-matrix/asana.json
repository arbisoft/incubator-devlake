    "text": "Connection Name*Give your connection a unique name to help you identify it in the future.Endpoint URL*Asana API base URL.Token*ProxyAdd a proxy if you cannot access Asana directly.Custom Rate LimitMaximum number of API requests per hour. Leave blank for default.",
    "typed": {
      "name": "v0",
      "endpoint": "v1",
      "token": "v2",
      "proxy": "v3",
      "rateLimitPerHour": 0
    }
  },
  "scopeConfig": {
    "mounted": {
      "issueTypeRequirement": "(feat|feature|story|requirement)",
      "issueTypeBug": "(bug|defect|broken)",
      "issueTypeIncident": "(incident|outage|failure)"
    },
    "controls": [
      {
        "tag": "input",
        "type": "text",
        "placeholder": "(feat|feature|story|requirement)"
      },
      {
        "tag": "input",
        "type": "text",
        "placeholder": "(bug|defect|broken)"
      },
      {
        "tag": "input",
        "type": "text",
        "placeholder": "(incident|outage|failure)"
      }
    ],
    "text": "Issue TrackingTell DevLake what your Asana tags mean to view metrics such as Bug Age, DORA - Median Time to Restore Service, etc.DevLake defines three standard types of issues: REQUIREMENT, BUG and INCIDENT. Classify your Asana tasks using tags that match the RegEx patterns below.RequirementBugIncidentDORA",
    "typed": {
      "issueTypeRequirement": "v0",
      "issueTypeBug": "v1",
      "issueTypeIncident": "v2"
    }
  },
