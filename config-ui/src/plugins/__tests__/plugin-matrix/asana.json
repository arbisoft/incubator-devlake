      "rateLimitPerHour": 0
    },
    "controls": [
      {
        "tag": "input",
        "type": "text",
        "placeholder": "Your Connection Name"
      },
      {
        "tag": "input",
        "type": "text",
        "placeholder": "Your Endpoint URL"
      },
      {
        "tag": "input",
        "type": "password",
