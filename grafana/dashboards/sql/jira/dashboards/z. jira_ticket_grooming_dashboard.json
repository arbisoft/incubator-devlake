          "rawSql": "SELECT DATE_FORMAT(ts, '%b %y') as `Month`, `No Context`, `No User Story`, `No Acceptance Criteria`\nFROM(\n  SELECT \n    DATE_FORMAT(i.created_date, '%Y-%m-01') as ts,\n    SUM(CASE WHEN i.description NOT LIKE '%context%' THEN 1 ELSE 0 END) AS `No Context`,\n    SUM(CASE WHEN i.description NOT LIKE '%user story%' THEN 1 ELSE 0 END) AS `No User Story`,\n    SUM(CASE WHEN i.description NOT LIKE '%acceptance criteria%' THEN 1 ELSE 0 END) AS `No Acceptance Criteria`\n  FROM issues i \n  WHERE i.id LIKE 'jira:%'\n    AND $__timeFilter(i.created_date) \n  AND ('__all' IN ($developer_id) OR i.creator_id IN ( $developer_id ))\n    AND EXISTS (\n      SELECT 1 FROM board_issues bi WHERE bi.issue_id = i.id AND bi.board_id IN ($board_id)\n    )\n  GROUP BY ts\n  ORDER BY ts desc\n) base",
