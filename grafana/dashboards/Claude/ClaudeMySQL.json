          "rawSql": "SELECT user AS \"User\", SUM(sessions) AS \"Sessions\", SUM(cost_usd) AS \"Cost (USD)\"\nFROM (\n  SELECT COALESCE(user_email, user_key) AS user, SUM(session_count) AS sessions, 0 AS cost_usd\n  FROM _tool_claude_code_otel_hourly_activity\n  WHERE $__timeFilter(hour_start) AND team_slug REGEXP '^(${otel_teams:regex})$'\n  GROUP BY COALESCE(user_email, user_key)\n  UNION ALL\n  SELECT COALESCE(user_email, user_key) AS user, 0 AS sessions, SUM(estimated_cost_usd) AS cost_usd\n  FROM _tool_claude_code_otel_hourly_model_usage\n  WHERE $__timeFilter(hour_start) AND team_slug REGEXP '^(${otel_teams:regex})$'\n  GROUP BY COALESCE(user_email, user_key)\n) AS user_usage\nGROUP BY user\nORDER BY SUM(sessions) DESC, SUM(cost_usd) DESC",
          "refId": "A"
        }
      ],
