                  "placement": "bottom",
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none",
                  "hideZeros": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "lineWidth": 1,
                    "fillOpacity": 80,
                    "gradientMode": "none",
                    "axisPlacement": "auto",
                    "axisLabel": "",
                    "axisSoftMin": 0,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "none",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": null
                      }
                    ]
                  },
                  "mappings": [],
                  "noValue": "–",
                  "decimals": 0
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Done"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "green"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "In progress"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "blue"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "To do"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "gray"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
