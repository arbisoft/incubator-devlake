#
# DevLake staging MySQL tuning.
#
# Derived from the production benchmark at
# arbisoft/hks-argocd:apps/devlake-datasources/base/mysql-cluster.yaml, adapted
# from a 3-node Percona group-replication cluster to a single container.
#
# THE KEY DIFFERENCE FROM THE BENCHMARK: there, mysqld owned an entire 8 GB
# node (~6.4 GiB practical envelope) on a dedicated pool. Here it shares one
# 4 vCPU / 8 GB VM with the DevLake ETL engine, Grafana, config-ui,
# oauth2-proxy and nginx. Budget:
#
#   OS + Docker daemon        ~0.7 GB
#   devlake (ETL)             ~2.0 GB
#   grafana                   ~0.5 GB
#   config-ui + oauth2 + nginx ~0.25 GB
#   = mysql envelope          ~3.0 GB   -> enforced by mem_limit: 3g
#
# Steady state against that 3 GiB cap:
#   buffer pool                     1.5   GiB
#   buffer pool control structures ~0.12  GiB
#   perf_schema + dict + open tables ~0.3 GiB
#   150 connections x ~1-2MB burst ~0.15-0.3 GiB
#   TempTable pool (capped below)   0.25  GiB
#   redo log buffer (default 16M)  ~0.02  GiB
#   = ~2.4 GiB, leaving ~0.6 GiB margin
#
# Anything NOT set here is deliberate. In particular there are no
# group_replication_* settings (no group), no binlog settings (log_bin is off
# via --skip-log-bin in the compose command), and no LD_PRELOAD jemalloc tuning
# (the official mysql:8.0 image does not bundle libjemalloc; Percona's does).
#
[mysqld]

# ---- sizing --------------------------------------------------------------
# innodb_buffer_pool_size is silently rounded UP to a multiple of
# innodb_buffer_pool_chunk_size (128M) x innodb_buffer_pool_instances. With
# instances = 4 the granularity is 512M, and 1610612736 = 3 x 512M exactly, so
# it applies verbatim. IF YOU CHANGE IT, keep it a multiple of 512M.
#
# 1.5 GiB is ~half the container. The benchmark measured the DevLake dataset at
# ~11 GB across ~510 tables, but it is dominated by write-once `_raw_*`
# collection tables that no dashboard reads, so the hot fraction is far
# smaller than the total and the pool covers most of it.
innodb_buffer_pool_instances = 4
innodb_buffer_pool_size      = 1610612736

# 1 DevLake (Go connection pool) + 1 Grafana (maxOpenConns 20) + admin. Bounds
# per-connection memory (sort/join buffers, ~1-2MB each under load) to
# ~0.15-0.3 GiB worst case, which the budget above absorbs. The benchmark used
# 200 against a roughly twice-larger envelope.
max_connections = 150

# ---- TempTable engine ----------------------------------------------------
# The risk is AGGREGATE concurrency, not one big query: any INDIVIDUAL
# in-memory temp table already converts to InnoDB on-disk at tmp_table_size
# (16 MiB default). What can balloon RAM is the SHARED TempTable pool, whose
# 1 GiB default is reachable by ~64 concurrent sessions each holding <=16 MiB.
temptable_max_ram = 256M
# ...and make that cap HARD. Overflow above temptable_max_ram does NOT go to
# disk by default -- it goes to memory-mapped files (another 1 GiB by default)
# whose dirty pages still count against the container's memory cgroup. So
# max_ram alone bounds nothing. 0 disables mmap allocation entirely, routing
# overflow to InnoDB on-disk internal temp tables, where slow beats OOM-killed.
temptable_max_mmap = 0

# ---- durability ----------------------------------------------------------
# The benchmark uses 1, but for a GR-specific reason that does NOT apply here:
# under group replication with sync_binlog=1, a value of 2 is crash-unsafe
# because recovery rebuilds gtid_executed from the binlog without replaying it
# into InnoDB, so a member can rejoin claiming GTIDs whose rows it lacks.
#
# This is a single node with log_bin OFF, so that failure mode cannot occur.
# The only exposure at 2 is losing ~1s of committed writes on an OS or power
# crash (not on a mysqld restart), and DevLake collection is replayable.
#
# Set to 2 if the nightly ETL proves fsync-bound on this VM's disk. Shipping
# the conservative value so that change is a deliberate, reviewed one.
innodb_flush_log_at_trx_commit = 1

# A defensible starting point, not a measurement -- same caveat the benchmark
# records for itself. Correct these after a fio run against the staging disk.
innodb_io_capacity     = 2000
innodb_io_capacity_max = 4000

# ---- redo log ------------------------------------------------------------
# The 100M default forces aggressive flushing during DevLake's nightly bulk
# collection. 512M absorbs the burst, scaled from the benchmark's 1G against
# its 2.5G pool. Requires MySQL 8.0.30+; the image is pinned well past that.
innodb_redo_log_capacity = 512M

# ---- scratch paths -------------------------------------------------------
# NO tmpdir / innodb_tmpdir OVERRIDE HERE, deliberately. The compose file
# mounts a named volume (devlake_staging_mysql_tmp) at /tmp, which is already
# MySQL's default tmpdir, so spill lands on that volume with no config to keep
# in sync and no host directory to pre-create.
#
# Historical context, because it is why any of this is here: the benchmark
# could not set tmpdir at all on ps-operator 1.1.0, and unbounded Grafana
# filesort spill onto node ephemeral storage evicted MySQL pods twice in seven
# days (~103 GiB and ~112 GiB written as open-but-deleted inodes, invisible to
# the kubelet's du accounting).
#
# BE HONEST ABOUT WHAT THE VOLUME BUYS. It does NOT put spill on a different
# filesystem: Docker named volumes live under /var/lib/docker/volumes, so on a
# single-filesystem VM a runaway query can still fill the disk. What it does
# buy is (a) spill is out of the container's writable layer, (b) its size is
# visible via `docker system df -v`, and (c) it can later be pointed at a
# dedicated disk with `driver_opts` without touching the service definition.
#
# The actual bounds on spill are the three settings in this file:
# temptable_max_mmap = 0, the 4G cap on innodb_temp_data_file_path below, and
# the init_connect 30s governor on the Grafana account.

# Cap the InnoDB temp tablespace, which the benchmark leaves unbounded. It
# lives on the data volume and never shrinks in-place, so without a max a
# single runaway query permanently claims the space until restart.
innodb_temp_data_file_path = ibtmp1:12M:autoextend:max:4G

# ---- query time limits ---------------------------------------------------
# GLOBAL 0, ON PURPOSE. DO NOT set a global cap here. DevLake's extract and
# convert stages issue plain read-only SELECTs over the `_raw_*` tables; a 30s
# global cap kills them with ERROR 3024 at midnight, on the stage that rebuilds
# the DORA metrics.
max_execution_time = 0

# The per-user governor the line above says it needs. Bounds ONLY the Grafana
# datasource account -- in the benchmark environment that account's unbounded
# filesort spill is what caused both node evictions.
#
# WHY init_connect: MySQL has no per-user max_execution_time. `ALTER USER ...
# WITH` offers only MAX_QUERIES_PER_HOUR / MAX_UPDATES_PER_HOUR /
# MAX_CONNECTIONS_PER_HOUR / MAX_USER_CONNECTIONS, none of them time-based.
# init_connect runs once per client connection and is the only hook available.
#
# WHY EXACT MATCH, NOT LIKE 'grafana%': `_` is a LIKE single-character wildcard
# and the account name contains one, so LIKE would also match e.g. grafanaXro.
#
# WHO IS EXEMPT: init_connect is skipped entirely for accounts holding SUPER or
# CONNECTION_ADMIN, so `root` is unaffected -- that is the recovery path below.
# It applies to the DevLake account, where it evaluates to 0: a no-op that
# preserves the ETL exemption.
#
# FAILURE MODE: a malformed init_connect fails the CONNECTION, not the
# statement, for every non-admin account -- an app-tier outage. Detect via
# Aborted_connects and the error log; recover with `SET GLOBAL init_connect=''`
# as root, which needs no restart.
#
# 30000 ms is chosen against Grafana's own 15s client timeout: panels have
# already given up by then, so nothing a user would have seen is lost.
#
# !!! COUPLED LITERAL -- KEEP IN SYNC WITH GRAFANA_DB_USER !!!
# The account is created from ${GRAFANA_DB_USER} in
# mysql/initdb/01-grafana-ro.sh. Nothing validates the two against each other:
# rename the account without editing this line and the governor silently
# becomes a no-op, with the only symptom being the Max_execution_time_set
# status counter staying at zero while Grafana is actively querying.
init_connect = "SET SESSION max_execution_time = IF(SUBSTRING_INDEX(CURRENT_USER(),'@',1) = 'grafana_ro', 30000, 0)"

# DO NOT set performance_schema = OFF to save memory. It is budgeted above,
# and it is the only source of the memory/IO instrumentation needed to size
# any of the numbers in this file.
