# ---------------------------------------------------------------------------
# Staging override of backend/Dockerfile — linux/amd64 only.
#
# Upstream backend/Dockerfile always builds a linux/arm64 debian stage so CI
# can produce multi-arch images. On an amd64 staging VM that stage fails with
# "exec format error" unless QEMU/binfmt is installed. This file drops arm64
# so `docker compose build` works on the single-arch host.
#
# Build context must still be the repo's backend/ directory (compose sets it).
# Keep this in sync with backend/Dockerfile when upgrading DevLake versions.
# ---------------------------------------------------------------------------

FROM --platform=linux/amd64 debian:bookworm AS debian-amd64
RUN apt-get update
RUN apt-get install -y libssh2-1-dev libssl-dev zlib1g-dev

FROM --platform=linux/amd64 golang:1.20.5-bookworm AS builder

ARG GOPROXY=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=

RUN apt-get update
RUN apt-get install -y gcc binutils libfindbin-libs-perl cmake libssh2-1-dev libssl-dev zlib1g-dev

RUN go install github.com/vektra/mockery/v2@v2.20.0
RUN go install github.com/swaggo/swag/cmd/swag@v1.16.1

COPY --from=debian-amd64 /usr/include /rootfs-amd64/usr/include
COPY --from=debian-amd64 /usr/lib/x86_64-linux-gnu /rootfs-amd64/usr/lib/x86_64-linux-gnu
COPY --from=debian-amd64 /lib/x86_64-linux-gnu /rootfs-amd64/lib/x86_64-linux-gnu

RUN mkdir -p /tmp/build/x86_64 && cd /tmp/build/x86_64 && \
    wget https://github.com/libgit2/libgit2/archive/refs/tags/v1.3.2.tar.gz -O - | tar -xz && \
    cd libgit2-1.3.2 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_C_COMPILER=gcc \
        -DBUILD_SHARED_LIBS=ON -DCMAKE_SYSROOT=/rootfs-amd64 \
        -DZLIB_LIBRARY=/rootfs-amd64/usr/lib/x86_64-linux-gnu/libz.so.1 \
        -DZLIB_INCLUDE_DIR=/rootfs-amd64/usr/include \
        -DCMAKE_INSTALL_PREFIX=/usr/local/deps/x86_64 && \
    make -j$(nproc) install


FROM builder AS build

WORKDIR /app
COPY . /app
ENV GOBIN=/app/bin

ARG TAG=
ARG SHA=
ARG GO_PLUGINS=

RUN --mount=type=cache,target=/root/.cache/go-build \
    ln -s /usr/local/deps/x86_64 /usr/local/deps/target && \
    export CC=gcc && \
    export GOARCH=amd64 && \
    export PKG_CONFIG_PATH=/usr/local/deps/target/lib/pkgconfig && \
    export CGO_ENABLED=1 && \
    DEVLAKE_PLUGINS="$GO_PLUGINS" make all

# remove symlink in lib, we will recreate in final image
RUN cd /usr/local/deps/target/lib && \
    for file in *.so* ; do \
        if [ -L $file ] ; then \
            unlink $file ; \
        fi \
    done


FROM --platform=linux/amd64 python:3.9-slim-bookworm AS base

RUN apt-get update && \
    apt-get install -y python3-dev python3-pip tar pkg-config curl libssh2-1 zlib1g libffi-dev default-libmysqlclient-dev libpq-dev tini git openssh-client corkscrew && \
    apt-get clean && \
    rm -fr /usr/share/doc/* \
           /usr/share/info/* \
           /usr/share/linda/* \
           /usr/share/lintian/overrides/* \
           /usr/share/locale/* \
           /usr/share/man/* \
           /usr/share/doc/kde/HTML/* \
           /usr/share/gnome/help/* \
           /usr/share/locale/* \
           /usr/share/omf/*/*-*.emf \
           /var/lib/apt/lists/*

EXPOSE 8080

RUN useradd -ms /bin/bash -d /app devlake -u 1010
RUN chown -R devlake:devlake /etc/ssl/certs
USER devlake
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN mkdir logs
VOLUME /app/logs

COPY python/ /app/python/
RUN python3 -m pip install --no-cache --upgrade pip setuptools && \
    python3 -m pip install --no-cache -r python/requirements.txt && \
    python3 -m pip install --upgrade pip

RUN curl -sSL https://install.python-poetry.org | python3 - --version 2.2.1
ENV PATH="$PATH:/app/.local/bin"

RUN /app/python/build.sh

FROM base AS devlake-base
ARG DEBUG=

ENV LD_LIBRARY_PATH=/app/libs
RUN mkdir -p /app/libs
COPY --from=build /usr/local/deps/target/lib/*.so* /app/libs
COPY --from=build /go/bin /usr/bin
RUN ldconfig -vn /app/libs

COPY --from=build /app/bin /app/bin
COPY --from=build /app/resources /app/resources

ENV PATH="/app/bin:${PATH}"
ENV DEBUG="$DEBUG"

USER root
RUN chgrp -R 0 /app && \
    chmod -R g=u /app
USER devlake

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["lake"]
