# ---------------------------------------------------------------------------
# Template for the staging .env
#
#   cp env.staging.example .env   # then fill in every REQUIRED value
#
# Compose loads .env from the directory holding the compose file, so this must
# sit beside docker-compose-staging.yml -
# /opt/devlake/incubator-devlake/devops/staging/.env on the staging host. It is
# per-host: never copy it between machines or into the repo.
#
# Every REQUIRED variable below is guarded with ${VAR:?} in the compose file,
# so a missing one fails immediately with a named error rather than producing
# an invalid image reference or a MySQL container that refuses to initialise.
#
# This file is a template. Do NOT commit the real .env: it is gitignored, and
# it holds the OAuth client secret and every database password.
#
# The full set of optional DevLake tunables lives in the repo-root env.example;
# only what staging actually needs is reproduced here.
# ---------------------------------------------------------------------------

##########################
# Image tags (REQUIRED)
##########################
# Local tags applied to images built from this checkout (see build: in
# docker-compose-staging.yml). Not Docker Hub / apache/* release pins.
# Keep APP_VERSION and GRAFANA_VERSION equal unless you have a reason not to.
#
# Optional GIT_SHA is passed to backend/Dockerfile as the SHA build-arg and
# baked into the lake binary. Leave empty to use "unknown".
#
# After a git pull / checkout of a new commit:
#   GIT_SHA=$(git rev-parse --short HEAD)
#   docker compose -f docker-compose-staging.yml build
APP_VERSION=staging
GRAFANA_VERSION=staging
GIT_SHA=

##########################
# MySQL (REQUIRED)
##########################
# The DevLake ETL account. Read-write on MYSQL_DATABASE.
MYSQL_DATABASE=devlake
MYSQL_USER=lake
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Grafana's read-only account, created on first initialisation by
# mysql/initdb/01-grafana-ro.sh. Keeping it separate from MYSQL_USER stops a
# dashboard query from writing to the DevLake schema, and it is what lets the
# init_connect governor in mysql/devlake.cnf cap Grafana's query time without
# also capping the midnight ETL.
#
# GRAFANA_DB_USER must stay 'grafana_ro': the governor compares against that
# literal, and renaming only this side makes it a silent no-op. The initdb
# script refuses to run if the two disagree.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=

##########################
# DevLake (REQUIRED)
##########################
# Encrypts stored data-source credentials. The server panics without it, and
# rotating it makes every existing connection undecryptable.
#   openssl rand -base64 48 | tr -d '\n'
ENCRYPTION_SECRET=

##########################
# Google OAuth via oauth2-proxy (REQUIRED)
##########################
# Web application client from console.cloud.google.com (APIs & Services ->
# Credentials). Its authorised redirect URIs must include exactly:
#   https://aperture.arbisoft.com/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be 16, 24 or 32 bytes; oauth2-proxy refuses to start otherwise.
#   openssl rand -base64 32 | tr -d '\n'
OAUTH2_COOKIE_SECRET=

##########################
# Grafana admin (REQUIRED)
##########################
# Grafana's own login form sits behind nginx's oauth2-proxy gate, but without
# an explicit password it boots as admin/admin - so this is not optional.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

##########################
# DevLake core (optional - defaults shown)
##########################
PLUGIN_DIR=bin/plugins
REMOTE_PLUGIN_DIR=python/plugins
PORT=8080
MODE=release
# Debug Info Warn Error
LOGGING_LEVEL=Info
DB_LOGGING_LEVEL=Error
ENABLE_STACKTRACE=true
FORCE_MIGRATION=false
RESUME_PIPELINES=true
API_TIMEOUT=120s
API_RETRY=3
API_REQUESTS_PER_HOUR=10000
# Raise only if the VM has headroom; each parallel pipeline is a memory
# multiplier against the ~2 GB budgeted for devlake in mysql/devlake.cnf.
PIPELINE_MAX_PARALLEL=1

##########################
# Security (optional)
##########################
IN_SECURE_SKIP_VERIFY=false
# CIDRs the collectors must never reach, comma separated. Worth setting on a
# VM that shares a network with other internal services.
ENDPOINT_CIDR_BLACKLIST=
FORBID_REDIRECTION=false

# DevLake's own authentication. Left off to match the default: today the only
# gate in front of the API is nginx's auth_request on /api/. Turning this on
# would make that defence-in-depth rather than the sole control, and give
# DevLake real per-user identity instead of trusting X-Forwarded-User.
# Requires SESSION_SECRET (>= 32 bytes) when enabled. See the repo-root
# env.example for the full OIDC block.
AUTH_ENABLED=false
